# ─────────────────────────────────────────────────────────────────────────────
#  Ticket Booking System — environment template
#
#  Copy to backend/.env (the API reads from there) and fill in the values.
#  NEVER commit a real .env. Every value below is a placeholder.
#
#  Generate the three secrets with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# Local (needs a replica set — see below): mongodb://localhost:27017/?replicaSet=rs0
# Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
# Multi-document transactions (used everywhere seats are held or booked) require a
# replica set — a single standalone `mongod` will not work. The easiest local option is
# a one-node replica set:
#   mongod --replSet rs0 --dbpath ./.mongo-data
#   mongosh --eval "rs.initiate()"
# or just point MONGODB_URI at a free MongoDB Atlas cluster, which is a replica set by
# default.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB_NAME=ticket_booking
MONGO_POOL_MAX=30

# How long a background job's lease-based lock (sweeper, outbox worker) is held before
# a crashed worker's lock is treated as free.
JOB_LOCK_TTL_MS=60000

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-me-with-32-random-bytes
JWT_REFRESH_SECRET=replace-me-with-a-different-32-random-bytes
# HMAC key that signs QR ticket payloads. Changing it invalidates existing QR codes.
TICKET_SECRET=replace-me-with-another-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
# How long a password-reset code stays valid. Self-service reset is CUSTOMER/ORGANISER
# only — ADMIN accounts are provisioned out of band and cannot be reset this way.
PASSWORD_RESET_TTL_MINUTES=10
# After the code is confirmed, this is how long the caller has to actually submit the
# new password — a short-lived, single-use authorisation distinct from the code itself.
PASSWORD_RESET_AUTHORIZATION_TTL_MINUTES=10
# Registration sends a 6-digit code to the given email before the account is created;
# these bound how long that code lives and how many wrong guesses it survives.
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# Minimum gap between two OTP emails (registration or password reset) to one address.
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Business rules ───────────────────────────────────────────────────────────
# Seat-hold TTL in seconds (the assignment's "e.g. 10 minutes"). Per-event override
# is stored on events.hold_ttl_seconds; this is the default applied at creation.
DEFAULT_HOLD_TTL=600
# How long a waitlisted customer has to claim an offered seat.
DEFAULT_OFFER_TTL=900
# Bookings can no longer be cancelled this many minutes before the event starts.
CANCEL_CUTOFF_MINUTES=120
MAX_SEATS_PER_HOLD=10
MAX_VENUE_SEATS=2000
MAX_OFFERS_PER_RUN=20

# ── Background jobs ──────────────────────────────────────────────────────────
# Correctness does NOT depend on these. Expired holds are treated as available by
# every read and write regardless; the sweeper tidies rows and pushes live updates.
JOBS_ENABLED=true
SWEEPER_INTERVAL_SECONDS=15
OUTBOX_INTERVAL_SECONDS=10

# ── Email ────────────────────────────────────────────────────────────────────
# resend | brevo | smtp | file (writes .html to MAIL_OUTBOX_DIR) | memory (tests).
# Business logic never depends on which one is selected — every call site only ever
# calls getTransport().send(), never a provider SDK directly, so switching is an env
# change only.
#
# Resend's free tier, with no verified domain, only delivers to the exact email address
# used to sign up for the Resend account itself — every other recipient is rejected with
# a "You can only send testing emails to your own email address" validation_error. That
# is a Resend account restriction, confirmed via their docs and live testing, not
# something this app can configure around.
#
# Brevo is the free arbitrary-recipient alternative that actually reaches any real
# address: it needs only a single verified sender email (a 6-digit code sent to that
# address at app.brevo.com/settings/keys/senders — no domain), free tier is 300
# emails/day, and — unlike smtp below — its API is HTTPS, so it isn't subject to
# networks (including Render's) blocking outbound SMTP ports. Its one gap: no inline
# content-id support, so the QR ticket attaches as a regular file instead of embedding
# in the email body through this provider. Get a key at app.brevo.com/settings/keys/api.
#
# For PRODUCTION arbitrary-recipient delivery through Resend instead:
#   1. Obtain a domain (any registrar).
#   2. Add it at resend.com/domains.
#   3. Add the DNS records Resend gives you, and wait for it to show verified.
#   4. Set EMAIL_FROM to an address on that domain, e.g.
#      EMAIL_FROM="Ticket Booking <noreply@yourverifieddomain.com>"
#   5. Restart the backend. No other code changes are needed.
#
# EMAIL_TRANSPORT=smtp (e.g. Gmail with an App Password — never your normal password) is
# also available, but confirmed BLOCKED both on a home network and from Render's free
# tier (live-tested: the outbox job failed with "Connection timeout" on both). Kept as an
# option only for networks that happen to allow outbound SMTP.
#
# EMAIL_TRANSPORT=file needs no external account at all: emails are written to
# MAIL_OUTBOX_DIR as .html.
EMAIL_TRANSPORT=file
RESEND_API_KEY=re_xxxxxxxxx
BREVO_API_KEY=xkeysib-xxxxxxxxx
EMAIL_FROM=Ticket Booking System <onboarding@resend.dev>
MAIL_OUTBOX_DIR=.mail-outbox

# Optional development provider (EMAIL_TRANSPORT=smtp). Leave blank otherwise.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=<your gmail address>, SMTP_PASSWORD=<a Google App Password, not your
# real password — generate one at myaccount.google.com/apppasswords>.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# ── URLs ─────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:4000
# Comma-separated CORS allowlist. Defaults to CLIENT_URL when unset.
# In production: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=15
HOLD_RATE_LIMIT_MAX=30

# ─────────────────────────────────────────────────────────────────────────────
#  Frontend (frontend/.env) — Vite only exposes variables prefixed with VITE_
# ─────────────────────────────────────────────────────────────────────────────
# VITE_API_URL=http://localhost:4000
# VITE_SOCKET_URL=http://localhost:4000
