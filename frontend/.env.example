# Frontend environment. Vite only exposes variables prefixed with VITE_.
#
# LOCAL DEVELOPMENT: leave both blank. vite.config.ts proxies /api and /socket.io to
# http://localhost:4000, so the browser talks to a single origin and there is no CORS
# or cookie-SameSite friction while you develop.
#
# PRODUCTION (Vercel): set both to your deployed API origin.

VITE_API_URL=
VITE_SOCKET_URL=

# Example for a Render deployment:
# VITE_API_URL=https://ticket-booking-api.onrender.com
# VITE_SOCKET_URL=https://ticket-booking-api.onrender.com
